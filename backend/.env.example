# Copier ce fichier en .env puis renseigner vos identifiants MySQL.
# Le fichier .env ne doit JAMAIS être versionné (déjà dans .gitignore).

# ── Base de données MySQL ───────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=votre_mot_de_passe
MYSQL_DATABASE=pfa_gnn

# ── Sécurité JWT ────────────────────────────────────
JWT_SECRET_KEY=remplacez-par-une-cle-secrete-longue-et-aleatoire
